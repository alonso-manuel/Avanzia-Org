# Plantilla del .env de producción (avanzia.org). Copiar como .env en el servidor y completar.
# Nunca subir el .env real al repositorio.

APP_NAME="Avanzia América Latina"
APP_ENV=production
# Generar en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Mientras se prueba: la URL del sitio de prueba. Al lanzar: https://avanzia.org
APP_URL=https://avanzia.org
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Misma base de datos que Studio (producción). Respaldar antes de migrar.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

INERTIA_SSR_ENABLED=false

# Correo saliente: avanzia.org usa Google Workspace (MX smtp.google.com), no el correo del hosting.
# MAIL_PASSWORD = contraseña de aplicación de avanzia@avanzia.org (myaccount.google.com/apppasswords,
# requiere verificación en 2 pasos), 16 letras sin espacios. Nunca la contraseña normal.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=avanzia@avanzia.org
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=avanzia@avanzia.org
MAIL_FROM_NAME="Avanzia América Latina"

# Específicos de la landing
AVANZIA_EMAIL_CONVENIOS=avanzia@avanzia.org
AVANZIA_UMBRAL_INTERESADOS=10
AVANZIA_OPINIONES_AUTOMATICAS=true
